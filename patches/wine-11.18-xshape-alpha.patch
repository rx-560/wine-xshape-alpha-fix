+#ifdef HAVE_LIBXSHAPE
+static void x11drv_surface_bake_shape_alpha( XImage *ximage, const RECT *area,
+                                             const BITMAPINFO *shape_info,
+                                             const void *shape_bits )
+{
+    const BYTE *shape;
+    UINT32 *color;
+    UINT shape_stride, color_stride;
+    RECT clipped = *area;
+    int x, y;
+
+    if (!shape_bits || ximage->depth != 32 || ximage->bits_per_pixel != 32)
+        return;
+
+    clipped.left   = max( clipped.left, 0 );
+    clipped.top    = max( clipped.top, 0 );
+    clipped.right  = min( clipped.right, ximage->width );
+    clipped.bottom = min( clipped.bottom, ximage->height );
+
+    if (clipped.left >= clipped.right || clipped.top >= clipped.bottom)
+        return;
+
+    shape_stride = shape_info->bmiHeader.biSizeImage /
+    abs( shape_info->bmiHeader.biHeight );
+    color_stride = ximage->bytes_per_line / sizeof(*color);
+
+    color = (UINT32 *)ximage->data + clipped.top * color_stride;
+    shape = (const BYTE *)shape_bits + clipped.top * shape_stride;
+
+    for (y = clipped.top; y < clipped.bottom;
+         y++, color += color_stride, shape += shape_stride)
+         {
+             for (x = clipped.left; x < clipped.right; x++)
+             {
+                 if (!(shape[x / 8] & (1 << (7 - (x & 7)))))
+                     color[x] = 0;
+             }
+         }
+}
+#endif
